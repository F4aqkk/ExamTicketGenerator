[flake8]
# Длина строки по умолчанию в flake8 — 79 знаков, оставляем её.
max-line-length = 79

# Папки, которые проверять не нужно: служебные, окружение разработчика
# и готовая сборка release/ExamTicket (там лежит чужой код библиотек).
exclude =
    .git,
    __pycache__,
    venv,
    build,
    dist,
    docs/_build,
    release
